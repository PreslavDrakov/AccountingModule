@page
@model AccountingModule.Pages.Products.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Product</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Product.ID" />
            <div class="form-group">
                <label asp-for="Product.Name" class="control-label"></label>
                <input asp-for="Product.Name" class="form-control" />
                <span asp-validation-for="Product.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Product.TypeValue" class="control-label">Type</label>
                <select asp-for="Product.TypeValue" class="form-control">
                    @foreach (ProductTypesEnum type in Enum.GetValues(typeof(ProductTypesEnum)))
                    {
                        <option value="@((int)type)">@type</option>
                    }
                </select>
                <span asp-validation-for="Product.TypeValue" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Product.SalesPrice" class="control-label">Sales price</label>
                <input asp-for="Product.SalesPrice" class="form-control" />
                <span asp-validation-for="Product.SalesPrice" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Product.CostPrice" class="control-label">Cost price</label>
                <input asp-for="Product.CostPrice" class="form-control" />
                <span asp-validation-for="Product.CostPrice" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Product.CanBeSold" /> Can be sold
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Product.CanBePurchased" /> Can be purchased
                </label>
            </div>
            <div class="form-group">
                <label asp-for="Product.CustomerTaxesID" class="control-label">Customer taxes</label>
                <select asp-for="Product.CustomerTaxesID" class="form-control" asp-items="ViewBag.CustomerTaxesID"></select>
                <span asp-validation-for="Product.CustomerTaxesID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Product.VendorTaxesID" class="control-label">Vendor taxes</label>
                <select asp-for="Product.VendorTaxesID" class="form-control" asp-items="ViewBag.VendorTaxesID"></select>
                <span asp-validation-for="Product.VendorTaxesID" class="text-danger"></span>
            </div>
            <div class="form-group" style="padding-top: 10px;">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
