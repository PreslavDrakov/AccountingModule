@page
@model AccountingModule.Pages.Taxes.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Tax</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Tax.Name" class="control-label"></label>
                <input asp-for="Tax.Name" class="form-control" />
                <span asp-validation-for="Tax.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Tax.Description" class="control-label"></label>
                <input asp-for="Tax.Description" class="form-control" />
                <span asp-validation-for="Tax.Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Tax.ComputationValue" class="control-label"></label>
                <input asp-for="Tax.ComputationValue" class="form-control" />
                <span asp-validation-for="Tax.ComputationValue" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Tax.IsActive" /> @Html.DisplayNameFor(model => model.Tax.IsActive)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="Tax.TypeValue" class="control-label"></label>
                <input asp-for="Tax.TypeValue" class="form-control" />
                <span asp-validation-for="Tax.TypeValue" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Tax.ScopeValue" class="control-label"></label>
                <input asp-for="Tax.ScopeValue" class="form-control" />
                <span asp-validation-for="Tax.ScopeValue" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Tax.Amount" class="control-label"></label>
                <input asp-for="Tax.Amount" class="form-control" />
                <span asp-validation-for="Tax.Amount" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
